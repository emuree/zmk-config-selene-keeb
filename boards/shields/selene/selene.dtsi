#include <dt-bindings/zmk/matrix_transform.h>
#include "selene-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
    };

    /*
     * Selene keyboard matrix layout
     *
     * Physical layout per side:
     * - 7 columns: extra, pinky, ring, middle, index, inner, extra2
     * - 5 rows: number, top, home, bottom, thumb
     *
     * Left side:  columns 0-6  (extra=0, pinky=1, ring=2, middle=3, index=4, inner=5, extra2=6)
     * Right side: columns 7-13 (extra2=7 inner=8, index=9, middle=10, ring=11, pinky=12, extra=13)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            // Row 0: Number row (7 + 7 = 14 keys)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)     RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            // Row 1: Top row (7 + 7 = 14 keys)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)     RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            // Row 2: Middle row (7 + 7 = 14 keys)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)     RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            // Row 3: Bottom row (7 + 7 = 14 keys)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            // Row 4: Thumb row (6 + 6 = 12 keys)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)         RC(4,4) RC(4,5)     RC(4,6) RC(4,7)         RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };
};

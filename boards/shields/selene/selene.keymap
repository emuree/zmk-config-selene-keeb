#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3     &kp N4  &kp N5  &kp PRINTSCREEN  &kp INSERT  &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp DEL
&kp TAB    &kp Q     &kp W     &kp E      &kp R   &kp T   &kp PG_UP        &kp HOME    &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp CAPS   &kp A     &kp S     &kp D      &kp F   &kp G   &kp PG_DN        &kp END     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V   &kp B                                &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &kp GRAVE          &mo 1   &kp ENTER        &kp SPACE   &mo 2           &kp LEFT   &kp UP   &kp DOWN  &kp RIGHT
            >;
        };

        Lower {
            bindings = <
&trans  &trans   &trans   &trans   &trans      &trans       &trans  &trans    &trans          &trans     &trans                &trans                 &trans        &trans
&trans  &kp F1   &kp F2   &kp F3   &kp DOLLAR  &kp PERCENT  &trans  &trans    &kp MINUS       &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans        &trans
&trans  &kp F4   &kp F5   &kp F6   &kp EXCL    &kp POUND    &trans  &trans    &kp UNDERSCORE  &kp EQUAL  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ASTERISK  &trans
&trans  &kp F7   &kp F8   &kp F9   &trans      &trans                         &kp AMPERSAND   &kp PIPE   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans        &trans
&trans  &kp F10  &kp F11  &kp F12              &trans       &trans  &kp BSPC  &trans                     &trans                &trans                 &trans        &trans
            >;
        };

        Raise {
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N7  &kp N8   &kp N9  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N4  &kp N5   &kp N6  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2   &kp N3  &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N0  &kp DOT          &trans  &kp LC(BACKSPACE)  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };
    };
};
